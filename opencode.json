{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git push *": "deny",
      "git fetch *": "deny",
      "git pull *": "deny",
      "gh *": "deny",
      "git reset --hard *": "deny",
      "git checkout -- *": "deny",
      "git clean *": "deny"
    }
  }
}
